{
    "openapi": "3.0.3",
    "info": {
        "title": "Drainage Monitoring IoT API",
        "version": "1.0.0",
        "description": "API untuk monitoring drainase berbasis IoT dengan InfluxDB, Firestore, Cloudinary, WebSocket, dan alert system."
    },
    "servers": [
        {
            "url": "http://localhost:3000"
        },
        {
            "url": "https://api.leviathanbolu.my.id"
        }
    ],
    "paths": {
        "/ws": {
            "get": {
                "summary": "WebSocket upgrade endpoint untuk streaming data sensor realtime",
                "description": "Gunakan endpoint ini untuk membuka koneksi WebSocket. Server akan mem-broadcast pesan bertipe `sensor` dan `alert`.",
                "responses": {
                    "101": {
                        "description": "WebSocket connection established"
                    },
                    "426": {
                        "description": "Upgrade required"
                    }
                }
            }
        },
        "/logs": {
            "get": {
                "summary": "Tampilkan halaman HTML log sistem 7 hari terakhir",
                "description": "Server-rendered page untuk melihat log perangkat. Dapat difilter dengan query `?device_id=<id>`.",
                "parameters": [
                    {
                        "name": "device_id",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        },
                        "description": "Filter log berdasarkan device_id"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "HTML page berhasil dirender",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Gagal render halaman log",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/health": {
            "get": {
                "summary": "Health check backend API",
                "responses": {
                    "200": {
                        "description": "API healthy",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/image": {
            "get": {
                "summary": "Ambil metadata URL gambar drainase paling terakhir dari Firestore",
                "responses": {
                    "200": {
                        "description": "Success get latest image metadata",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LatestImageResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Belum ada data gambar di Firestore",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Upload image dari ESP32-CAM ke Cloudinary dan simpan metadata ke Firestore",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "image": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "File biner foto dari kamera sensor"
                                    },
                                    "device_id": {
                                        "type": "string",
                                        "example": "dev01",
                                        "description": "ID unit IoT drainase pengirim gambar"
                                    }
                                },
                                "required": [
                                    "image",
                                    "device_id"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Upload dan simpan metadata Firestore sukses",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ImageUploadResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Request tidak valid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/devices/{device_id}/snapshot": {
            "post": {
                "summary": "Upload snapshot terjadwal per device",
                "description": "Endpoint untuk snapshot harian. `device_id` diambil dari URL path, sedangkan file gambar dikirim sebagai multipart form field `image`.",
                "parameters": [
                    {
                        "name": "device_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        },
                        "description": "ID device IoT"
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "image": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "File biner snapshot dari kamera sensor"
                                    }
                                },
                                "required": [
                                    "image"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Snapshot berhasil disimpan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ImageUploadResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Request tidak valid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sensor/history/{device_id}": {
            "get": {
                "summary": "Get sensor history berdasarkan rentang waktu",
                "parameters": [
                    {
                        "name": "device_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "start_date",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "description": "Waktu awal dalam format RFC3339 / ISO-8601"
                    },
                    {
                        "name": "end_date",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "description": "Waktu akhir dalam format RFC3339 / ISO-8601"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success get history data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SensorHistoryResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error pada query parameter",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sensor/latest/{device_id}": {
            "get": {
                "summary": "Get data sensor paling terakhir",
                "parameters": [
                    {
                        "name": "device_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success get latest single sensor data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SensorHistoryResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/register-token": {
            "post": {
                "summary": "Registrasi multi-device FCM Token HP via Backend Gateway",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterTokenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token successfully registered/updated in Firestore",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericSuccessResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request atau body payload tidak lengkap",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ErrorResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "error"
                    },
                    "message": {
                        "type": "string",
                        "example": "Something went wrong"
                    },
                    "error": {
                        "oneOf": [
                            {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                }
                            },
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                }
            },
            "ValidationErrorResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "error"
                    },
                    "message": {
                        "type": "string",
                        "example": "Validation error"
                    },
                    "error": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "example": {
                            "start_date": "required",
                            "end_date": "invalid format"
                        }
                    }
                }
            },
            "HealthResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "API is healthy"
                    },
                    "data": {
                        "type": "object",
                        "nullable": true,
                        "example": null
                    }
                }
            },
            "GenericSuccessResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Token registered successfully"
                    },
                    "data": {
                        "type": "object",
                        "nullable": true,
                        "example": null
                    }
                }
            },
            "ImageUploadResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "created"
                    },
                    "message": {
                        "type": "string",
                        "example": "Flood image uploaded successfully"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "secure_url": {
                                "type": "string",
                                "example": "https://res.cloudinary.com/demo/image/upload/v1234/drainage.jpg"
                            }
                        }
                    }
                }
            },
            "LatestImageResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Latest image retrieved successfully"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "url": {
                                "type": "string",
                                "example": "https://res.cloudinary.com/demo/image/upload/v1234/drainage.jpg"
                            },
                            "last_updated": {
                                "type": "integer",
                                "example": 1698240000
                            }
                        }
                    }
                }
            },
            "SensorHistory": {
                "type": "object",
                "properties": {
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "device_id": {
                        "type": "string",
                        "example": "dev01"
                    },
                    "water_distance": {
                        "type": "number",
                        "example": 14.2
                    },
                    "water_level_cm": {
                        "type": "number",
                        "example": 35.8
                    },
                    "status": {
                        "type": "string",
                        "example": "NORMAL",
                        "description": "Status hasil keputusan device: NORMAL/WASPADA/BAHAYA"
                    },
                    "rain_detected": {
                        "type": "boolean",
                        "example": true
                    },
                    "sensor_flag": {
                        "type": "string",
                        "example": "OK"
                    },
                    "next_wakeup_sec": {
                        "type": "integer",
                        "example": 60
                    }
                }
            },
            "SensorHistoryResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Sensor history fetched successfully"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SensorHistory"
                        }
                    }
                }
            },
            "RegisterTokenRequest": {
                "type": "object",
                "required": [
                    "device_id",
                    "app_instance_id",
                    "fcm_token"
                ],
                "properties": {
                    "device_id": {
                        "type": "string",
                        "example": "dev01",
                        "description": "ID unit IoT drainase yang dipantau"
                    },
                    "app_instance_id": {
                        "type": "string",
                        "example": "iphone_krisna_123",
                        "description": "ID unik perangkat HP pemantau"
                    },
                    "fcm_token": {
                        "type": "string",
                        "example": "fcm_token_firebase_abc123xyz...",
                        "description": "FCM token asli dari client-side mobile app"
                    }
                }
            }
        }
    }
}
{
    "openapi": "3.0.3",
    "info": {
        "title": "Drainage Monitoring IoT API",
        "version": "1.0.0",
        "description": "API untuk monitoring drainase berbasis IoT dengan InfluxDB, Firestore, dan alert system."
    },
    "servers": [
        {
            "url": "http://localhost:3000"
        }
    ],
    "paths": {
        "/api/health": {
            "get": {
                "summary": "Health check backend API",
                "responses": {
                    "200": {
                        "description": "API healthy",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/image": {
            "get": {
                "summary": "Ambil metadata URL gambar drainase terakhir",
                "responses": {
                    "200": {
                        "description": "Success get latest image metadata",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LatestImageResponse"
                                }
                            }
                        }
                    }
                }
            },
            "post": {
                "summary": "Upload image dari ESP32-CAM ke Cloudinary & InfluxDB",
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "image": {
                                        "type": "string",
                                        "format": "binary"
                                    },
                                    "device_id": {
                                        "type": "string",
                                        "example": "dev01"
                                    }
                                },
                                "required": [
                                    "image",
                                    "device_id"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Upload image success",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericSuccessResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sensor/history/{device_id}": {
            "get": {
                "summary": "Get sensor history berdasarkan rentang waktu",
                "parameters": [
                    {
                        "name": "device_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "start_date",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    },
                    {
                        "name": "end_date",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "date-time"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success get history data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SensorHistoryResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error pada query parameter",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sensor/latest/{device_id}": {
            "get": {
                "summary": "Get data sensor paling terakhir",
                "parameters": [
                    {
                        "name": "device_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success get latest single sensor data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SensorHistoryResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/register-token": {
            "post": {
                "summary": "Registrasi multi-device FCM Token HP via Backend Gateway",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterTokenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token successfully registered/updated in Firestore",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GenericSuccessResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Bad request atau body payload tidak lengkap",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "device_id, app_instance_id, dan token wajib diisi"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RegisterTokenRequest": {
                "type": "object",
                "required": [
                    "device_id",
                    "app_instance_id",
                    "token"
                ],
                "properties": {
                    "device_id": {
                        "type": "string",
                        "example": "dev01",
                        "description": "ID unit IoT drainase yang dipantau"
                    },
                    "app_instance_id": {
                        "type": "string",
                        "example": "iphone_krisna_123",
                        "description": "ID Unik perangkat HP pemantau"
                    },
                    "token": {
                        "type": "string",
                        "example": "fcm_token_firebase_abc123xyz...",
                        "description": "FCM Token asli dari client-side mobile app"
                    }
                }
            },
            "SensorHistory": {
                "type": "object",
                "properties": {
                    "timestamp": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "water_distance": {
                        "type": "number"
                    },
                    "rain_detected": {
                        "type": "boolean"
                    },
                    "rain_intensity": {
                        "type": "number"
                    }
                }
            },
            "SensorHistoryResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Success operation"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SensorHistory"
                        }
                    }
                }
            },
            "LatestImageResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Success get latest image metadata"
                    },
                    "data": {
                        "type": "object",
                        "properties": {
                            "url": {
                                "type": "string",
                                "example": "https://res.cloudinary.com/demo/image/upload/v1234/drainage.jpg"
                            },
                            "last_updated": {
                                "type": "integer",
                                "example": 1698240000
                            }
                        }
                    }
                }
            },
            "HealthResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "API is healthy"
                    },
                    "data": {
                        "type": "object",
                        "nullable": true,
                        "example": null
                    }
                }
            },
            "GenericSuccessResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    },
                    "message": {
                        "type": "string",
                        "example": "Operation successful"
                    },
                    "data": {
                        "type": "object",
                        "nullable": true,
                        "example": null
                    }
                }
            },
            "ValidationErrorResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "error"
                    },
                    "message": {
                        "type": "string",
                        "example": "Validation error"
                    },
                    "error": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string"
                        },
                        "example": {
                            "start_date": "required",
                            "end_date": "invalid format"
                        }
                    }
                }
            }
        }
    }
}